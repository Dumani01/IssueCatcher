{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrate src/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrate src/seed.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.6.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
