NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=https://CONFIGURE_DEPLOYMENT_DOMAIN
DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@POOLER_HOST:5432/postgres
DB_TLS=true
DB_CA="OFFICIAL_CA_PEM_WITH_ESCAPED_NEWLINES"
JWT_SECRET=GENERATE_PRIVATE_RANDOM_VALUE
DATA_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64
TRUST_PROXY=0
SMTP_HOST=CONFIGURE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CONFIGURE_PRIVATE_USER
SMTP_PASSWORD=CONFIGURE_PRIVATE_PASSWORD
SMTP_FROM=CONFIGURE_VERIFIED_SENDER
